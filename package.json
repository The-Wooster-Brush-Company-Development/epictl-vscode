{
  "name": "epictl-vscode",
  "displayName": "Epictl-VSCode",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Epictl Configuration",
      "properties": {
        "epictl.command_path": {
          "type": "string",
          "default": ""
        },
        "epictl.manifest_dir_path": {
          "type": "string",
          "default": ""
        }
      }
    },
    "commands": [
      {
        "command": "epictl.createConfig",
        "title": "Epiclt: Create Config",
        "category": "Epictl"
      },
      {
        "command": "epictl.getConfig",
        "title": "Epictl: Get Config",
        "category": "Epictl"
      },
      {
        "command": "epictl.setConfig",
        "title": "Epictl: Set Config",
        "category": "Epictl"
      },
      {
        "command": "epictl.deleteConfig",
        "title": "Epictl: Delete Config",
        "category": "Epictl"
      },
      {
        "command": "epictl.activeConfig",
        "title": "Epictl: Active Config",
        "category": "Epictl"
      },
      {
        "command": "epictl.setExecPath",
        "title": "Epictl: Set Executable Path",
        "category": "Epictl"
      },
      {
        "command": "epictl.getExecPath",
        "title": "Epictl: Get Executable Path",
        "category": "Epictl"
      },
      {
        "command": "epictl.deleteExecPath",
        "title": "Epictl: Delete Executable Path",
        "category": "Epictl"
      },
      {
        "command": "epictl.setManifestDirPath",
        "title": "Epictl: Set Manifest Directory",
        "category": "Epictl"
      },
      {
        "command": "epictl.getManifestDirPath",
        "title": "Epictl: Get Manifest Directory",
        "category": "Epictl"
      },
      {
        "command": "epictl.deleteLocalManifest",
        "title": "Epictl: Delete Local Manifest",
        "category": "Epictl"
      },
      {
        "command": "epictl.initManifest",
        "title": "Epictl: Initialize Manifest",
        "category": "Epictl"
      },
      {
        "command": "epictl.cloneManifest",
        "title": "Epictl: Clone Manifest",
        "category": "Epictl"
      },
      {
        "command": "epictl.getManifests",
        "title": "Epictl: Get Manifests",
        "category": "Epictl"
      },
      {
        "command": "epictl.getBoms",
        "title": "Epictl: Get BOMs",
        "category": "Epictl"
      },
      {
        "command": "epictl.getTables",
        "title": "Epictl: Get Tables",
        "category": "Epictl"
      },
      {
        "command": "epictl.describeBom",
        "title": "Epictl: Describe BOM",
        "category": "Epictl"
      },
      {
        "command": "epictl.describeTable",
        "title": "Epictl: Describe Table",
        "category": "Epictl"
      },
      {
        "command": "epictl.describeBpm",
        "title": "Epictl: Describe BPM",
        "category": "Epictl"
      },
      {
        "command": "epictl.applyBpm",
        "title": "Epictl: Apply BPM",
        "category": "Epictl"
      },
      {
        "command": "epictl.updateBpm",
        "title": "Epictl: Update BPM",
        "category": "Epictl"
      },
      {
        "command": "epictl.deleteBpm",
        "title": "Epictl: Delete BPM",
        "category": "Epictl"
      },
      {
        "command": "epictl.validateCode",
        "title": "Epictl: Validate Code",
        "category": "Epictl"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
