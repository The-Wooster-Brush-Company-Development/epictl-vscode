{
  "name": "epictl-vscode",
  "displayName": "Epictl-VSCode",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Epictl Configuration",
      "properties": {
        "epictl.command_path": {
          "type": "string",
          "default": ""
        },
        "epictl.manifest_dir_path": {
          "type": "string",
          "default": ""
        }
      }
    },
    "commands": [
      {
        "command": "epictl: createConfig",
        "title": "epictl: createConfig"
      },
      {
        "command": "epictl: setExecPath",
        "title": "epictl: setExecPath"
      },
      {
        "command": "epictl: getExecPath",
        "title": "epictl: getExecPath"
      },
      {
        "command": "epictl: deleteExecPath",
        "title": "epictl: deleteExecPath"
      },
      {
        "command": "epictl: setManifestDirPath",
        "title": "epictl: setManifestDirPath"
      },
      {
        "command": "epictl: getManifestDirPath",
        "title": "epictl: getManifestDirPath"
      },
      {
        "command": "epictl: deleteManifestDirPath",
        "title": "epictl: deleteManifestDirPath"
      },
      {
        "command": "epictl: init-manifest",
        "title": "epictl: init-manifest"
      },
      {
        "command": "epictl: clone-manifest",
        "title": "epictl: clone-manifest"
      },
      {
        "command": "epictl: getBoms",
        "title": "epictl: getBoms"
      },
      {
        "command": "epictl: getTables",
        "title": "epictl: getTables"
      },
      {
        "command": "epictl: describeBom",
        "title": "epictl: describeBom"
      },
      {
        "command": "epictl: describeTable",
        "title": "epictl: describeTable"
      },
      {
        "command": "epictl: describeBpm",
        "title": "epictl: describeBpm"
      },
      {
        "command": "epictl: applyBpm",
        "title": "epictl: applyBpm"
      },
      {
        "command": "epictl: updateBpm",
        "title": "epictl: updateBpm"
      },
      {
        "command": "epictl: deleteBpm",
        "title": "epictl: deleteBpm"
      },
      {
        "command": "epictl: validateCode",
        "title": "epictl: validateCode"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
