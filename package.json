{
  "name": "epictl-vscode",
  "displayName": "Epictl-VSCode",
  "description": "",
  "publisher": "WBC",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Epictl Configuration",
      "properties": {
        "epictl.command_path": {
          "type": "string",
          "default": ""
        },
        "epictl.manifest_dir_path": {
          "type": "string",
          "default": ""
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wbc",
          "title": "WBC",
          "icon": "$(brush)"
        }
      ]
    },
    "views": {
      "wbc": [
        {
          "type": "webview",
          "id": "bpmMenu",
          "name": "Bpm Menu"
        },
        {
          "type": "webview",
          "id": "contextMenu",
          "name": "Context Menu"
        },
        {
          "id": "epictlExplorer",
          "name": "Epictl Explorer"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "epictl.refreshTreeView",
          "when": "view == bpmMenu || view == epictlExplorer || view == contextMenu",
          "title": "Refresh Tree View",
          "group": "navigation@1"
        },
        {
          "command": "epictl.applyCode",
          "when": "view == bpmMenu",
          "title": "Apply Code",
          "group": "navigation@2"
        }
      ]
    },
    "commands": [
      {
        "command": "epictl.createConfig",
        "title": "Create Config",
        "category": "Epictl"
      },
      {
        "command": "epictl.getConfig",
        "title": "Get Config",
        "category": "Epictl"
      },
      {
        "command": "epictl.setConfig",
        "title": "Set Config",
        "category": "Epictl"
      },
      {
        "command": "epictl.deleteConfig",
        "title": "Delete Config",
        "category": "Epictl"
      },
      {
        "command": "epictl.activeConfig",
        "title": "Active Config",
        "category": "Epictl"
      },
      {
        "command": "epictl.setExecPath",
        "title": "Set Executable Path",
        "category": "Epictl"
      },
      {
        "command": "epictl.getExecPath",
        "title": "Get Executable Path",
        "category": "Epictl"
      },
      {
        "command": "epictl.deleteExecPath",
        "title": "Delete Executable Path",
        "category": "Epictl"
      },
      {
        "command": "epictl.setCodeDirPath",
        "title": "Set Code Directory Path",
        "category": "Epictl"
      },
      {
        "command": "epictl.getCodeDirPath",
        "title": "Get Code Directory Path",
        "category": "Epictl"
      },
      {
        "command": "epictl.deleteCodeDirPath",
        "title": "Delete Code Directory Path",
        "category": "Epictl"
      },
      {
        "command": "epictl.setManifestDirPath",
        "title": "Set Manifest Directory",
        "category": "Epictl"
      },
      {
        "command": "epictl.getManifestDirPath",
        "title": "Get Manifest Directory",
        "category": "Epictl"
      },
      {
        "command": "epictl.deleteLocalManifest",
        "title": "Delete Local Manifest",
        "category": "Epictl"
      },
      {
        "command": "epictl.addFileToManifest",
        "title": "Add Code File to Manifest",
        "category": "Epictl"
      },
      {
        "command": "epictl.deleteCodeFileFromManifest",
        "title": "Delete Code File from Manifest",
        "category": "Epictl"
      },
      {
        "command": "epictl.initManifest",
        "title": "Initialize Manifest",
        "category": "Epictl"
      },
      {
        "command": "epictl.cloneManifest",
        "title": "Clone Manifest",
        "category": "Epictl"
      },
      {
        "command": "epictl.getManifests",
        "title": "Get Manifests",
        "category": "Epictl"
      },
      {
        "command": "epictl.getBoms",
        "title": "Get Boms",
        "category": "Epictl"
      },
      {
        "command": "epictl.getTables",
        "title": "Get Tables",
        "category": "Epictl"
      },
      {
        "command": "epictl.describeBom",
        "title": "Describe Bom",
        "category": "Epictl"
      },
      {
        "command": "epictl.describeTable",
        "title": "Describe Table",
        "category": "Epictl"
      },
      {
        "command": "epictl.describeBpm",
        "title": "Describe Bpm",
        "category": "Epictl"
      },
      {
        "command": "epictl.applyBpm",
        "title": "Apply BPM",
        "category": "Epictl"
      },
      {
        "command": "epictl.updateBpm",
        "title": "Update BPM",
        "category": "Epictl"
      },
      {
        "command": "epictl.deleteBpm",
        "title": "Delete BPM",
        "category": "Epictl"
      },
      {
        "command": "epictl.validateCode",
        "title": "Validate Code",
        "category": "Epictl"
      },
      {
        "command": "epictl.refreshTreeView",
        "title": "Refresh Tree View",
        "icon": "$(refresh)",
        "category": "Epictl"
      },
      {
        "command": "epictl.applyCode",
        "title": "Apply Code",
        "icon": "$(cloud-upload)",
        "category": "Epictl"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
