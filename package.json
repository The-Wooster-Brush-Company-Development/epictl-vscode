{
  "name": "epictl-vscode",
  "displayName": "Epictl-VSCode",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
